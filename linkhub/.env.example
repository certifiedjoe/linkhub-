# Copy to .env.local and fill in from your Supabase project.
# Dashboard -> Project Settings -> API

# ---- Frontend (inlined into the bundle at build time, safe to expose) ----
# Public origin of the deployed Express API, e.g. https://api.kiungo.link
NEXT_PUBLIC_KIUNGO_API_URL=https://YOUR-API-HOST
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- API server (server/api.js) ----
# Used to fetch the project's public JWKS and verify tokens. Same URL as above.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Only needed if your project still uses the legacy shared HS256 JWT secret
# (Project Settings -> API -> JWT Settings). Leave blank on projects using
# asymmetric signing keys, which is the current default. Keep this secret.
SUPABASE_JWT_SECRET=

# Optional: lock the API down to your site's origin instead of "*"
# CORS_ORIGIN=http://localhost:3000

# Optional: API port (default 8000)
# PORT=8000
