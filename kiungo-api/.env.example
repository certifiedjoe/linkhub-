# Copy to .env in this directory on the server.
NODE_ENV=production
PORT=8000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
CORS_ORIGIN=https://kiungo.link,https://www.kiungo.link

# Optional: only for legacy HS256 JWT signing projects.
# Current asymmetric signing projects verify through Supabase JWKS.
SUPABASE_JWT_SECRET=

# Native app association values. Set these from the actual signed mobile apps.
# IOS_APP_ID format: Apple Team ID + bundle ID (TEAMID.com.example.app)
IOS_APP_ID=
ANDROID_PACKAGE_NAME=
# Comma-separated SHA-256 signing certificate fingerprints (colon-separated)
ANDROID_SHA256_CERT_FINGERPRINTS=
