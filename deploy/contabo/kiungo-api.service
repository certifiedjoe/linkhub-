[Unit]
Description=Kiungo Express API
After=network.target

[Service]
Type=simple
User=kiungo
Group=kiungo
WorkingDirectory=/opt/kiungo/app/kiungo-api
EnvironmentFile=/etc/kiungo/kiungo-api.env
ExecStart=/usr/bin/node /opt/kiungo/app/kiungo-api/index.js
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/kiungo/app

[Install]
WantedBy=multi-user.target
