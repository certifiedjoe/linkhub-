# Copy to .env in this directory on the server.
NODE_ENV=production
PORT=8000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
CORS_ORIGIN=https://kiungo.link,https://www.kiungo.link

# Optional: only for legacy HS256 JWT signing projects.
# Current asymmetric signing projects verify through Supabase JWKS.
SUPABASE_JWT_SECRET=
